pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Build started successfully!'
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing started...'
                echo 'All tests passed successfully!'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment started...'
                echo 'Application deployed successfully!'
            }
        }
    }
}
